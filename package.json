{
  "name": "encrypted-gdrive-sync",
  "version": "1.2.0",
  "description": "E2E encrypted Google Drive sync for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test tests/*.test.cjs",
    "lint": "eslint src package.json --max-warnings 0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "esbuild": "^0.20.0",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "17.12.0",
    "obsidian": "1.13.1",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0"
  }
}
